# Copy to .env.local (gitignored) and fill in. Names follow docs/BACKEND_STACK.md §12.
# The backend loads ../.env.local for `npm run dev`, `npm start`, and `npm run db:*`.
# Never commit real values.

# --- Server -------------------------------------------------------------
# Backend listen port (Railway sets PORT itself). next dev proxies /api/* here.
PORT=8787
# Browser-facing origin: next dev locally, the Vercel production domain when deployed.
PUBLIC_ORIGIN=http://localhost:3000

# --- Database (Tiger Cloud) ---------------------------------------------
# Tiger console → your service → Connect. Use sslmode=verify-full.
DATABASE_URL=postgres://<user>:<password>@<host>:<port>/tsdb?sslmode=verify-full
# Owner connection used by dbmate (`npm run db:migrate`); may equal DATABASE_URL for the demo.
MIGRATION_DATABASE_URL=postgres://<user>:<password>@<host>:<port>/tsdb?sslmode=verify-full

# --- Auth -----------------------------------------------------------------
# Generate each with: openssl rand -base64 32
BETTER_AUTH_SECRET=
EMAIL_HASH_PEPPER=
# "edu" accepts any .edu address; or a list such as unc.edu,duke.edu
CAMPUS_EMAIL_DOMAINS=edu
# true logs sign-in codes to the server console instead of emailing them.
DEMO_MODE=true
# Required when DEMO_MODE=false.
RESEND_API_KEY=
OTP_EMAIL_FROM=

# --- Evidence research (Gemini) ------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional; read-only public scope, lifts GitHub's 60 req/h unauthenticated limit.
GITHUB_TOKEN=

# --- Planned (documented, not read by the backend yet) --------------------
SOLANA_RPC_URL=
SOLANA_WS_URL=
PROGRAM_ID=
PAYMENT_MINT=
# base58; Devnet only, never reuse on mainnet.
RELAYER_SECRET_KEY=
NESSIE_API_KEY=
NESSIE_BASE_URL=
NESSIE_PROFILE=
NESSIE_TREASURY_ACCOUNT_ID=
NESSIE_ENABLED=true
FUNDING_PAUSED=false
DEMO_GENERATION_ID=
WORKER_IN_PROCESS=false
